# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Required for CourtReserve auto-sync and admin operations)
# WARNING: Keep this secret! Never commit to version control or expose in client-side code
# Get this from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CourtReserve Configuration (Optional - only needed if integrating with CourtReserve)
# Contact CourtReserve support to get your API credentials
COURTRESERVE_USERNAME=your-courtreserve-username
COURTRESERVE_PASSWORD=your-courtreserve-password
COURTRESERVE_API_URL=https://app.courtreserve.com/Online/API

# Stripe Configuration
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
# IMPORTANT: Use test keys for development and live keys for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Sentry Configuration (Optional - for error monitoring and performance tracking)
# Create a free account at https://sentry.io and get your DSN
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Redis Configuration (Optional - for advanced caching and rate limiting)
# Get a free Redis instance from Upstash: https://upstash.com
# Format: redis://default:password@endpoint:port
VITE_REDIS_URL=redis://default:your-password@your-endpoint.upstash.io:6379

# Environment
NODE_ENV=development
