{
  "expo": {
    "name": "PaddleGrid",
    "slug": "paddlegrid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10b981"
    },
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "description": "PaddleGrid - The all-in-one platform for pickleball facilities and players. Book courts, join matches, track your stats, and connect with the pickleball community.",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paddlegrid.app",
      "buildNumber": "1",
      "deploymentTarget": "15.1",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#10b981",
        "tabletImage": "./assets/splash.png"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow PaddleGrid to access your camera to take profile pictures and post photos.",
        "NSPhotoLibraryUsageDescription": "Allow PaddleGrid to access your photos to select profile pictures and post photos.",
        "NSUserNotificationsUsageDescription": "PaddleGrid sends you timely notifications about booking extensions, match invitations, and community updates.",
        "ITSAppUsesNonExemptEncryption": false,
        "UILaunchStoryboardName": "SplashScreen"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10b981"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#10b981"
      },
      "package": "com.paddlegrid.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f69a4a7c-1b1a-427b-98c0-375bb729f48a"
      }
    },
    "owner": "justinsmith2099",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10b981",
          "sounds": ["./assets/notification.wav"]
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#10b981",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "PaddleGrid"
    },
    "scheme": "paddlegrid"
  }
}
